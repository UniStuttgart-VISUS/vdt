{
    "Description": "Installs vanilla Windows from a user-selected image without applying any customisations.",
    "ID": "VANILLA-OOBE",
    "Name": "Install user-selected image",
    "Phase": "Installation",
    "Tasks": [
        {
            "Task": "Visus.DeploymentToolkit.Tasks.SelectImage"
        },
        {
            "Task": "Visus.DeploymentToolkit.Tasks.SelectInstallDisk",
            "Parameters": {
                "Steps": [
                    {
                        "BuiltInCondition": "IsReadOnly",
                        "Action": "Exclude"
                    },
                    {
                        "BuiltInCondition": "IsUninitialised",
                        "Action": "Prefer"
                    },
                    {
                        "Condition": "BusType == \"Nvme\"",
                        "Action": "Exclude"
                    },
                    {
                        "BuiltInCondition": "IsEmpty",
                        "Action": "Prefer"
                    },
                    {
                        "Condition": "FriendlyName.Contains(\"PRO\")",
                        "Action": "Prefer"
                    },
                    {
                        "BuiltInCondition": "IsLargest",
                        "Action": "Include"
                    }
                ]
            }
         },
        {
            "Task": "Visus.DeploymentToolkit.Tasks.PartitionFormatDisk"
        },
        {
            "Task": "Visus.DeploymentToolkit.Tasks.ApplyImage"
        },
        {
            "Task": "Visus.DeploymentToolkit.Tasks.RestoreBootConfiguration"
        },
        {
            "Task": "Visus.DeploymentToolkit.Tasks.RebootMachine"
        }
    ]
}